BotToken=
# SQLite database path. Local default: ./database/apswiftly.sqlite
# Production: /var/www/nest.apstudy.org/instance/apswiftly/apswiftly.sqlite
SQLITE_PATH=

# Comma-separated Discord user IDs allowed to run Developer/owner commands.
BOT_OWNER_IDS=

# --- Legacy aoi.db migration only (not required at runtime) ---
# DBsecurityKey was used by aoi.db; retained only for reference/backup.
DBsecurityKey=
# AOI_DB_PATH points at the old aoi.db scheme directory during migration.
AOI_DB_PATH=

# Optional authenticated local control API (used by the Nest admin integration).
APSWIFTLY_CONTROL_TOKEN=
APSWIFTLY_CONTROL_HOST=127.0.0.1
APSWIFTLY_CONTROL_PORT=3921
